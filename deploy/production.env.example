# Copy to .env.production on the deployment host. Do not commit real settings.
# DOMAIN is a DNS hostname only, with no scheme, port or path.
DOMAIN=personalise.example.com
# Must match DOMAIN exactly. HTTPS overlay sets this for web and worker.
BASE_URL=https://personalise.example.com
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=50000000
MIN_FREE_STORAGE_MB=1000
JOB_TIMEOUT_MS=900000
JOB_MAX_ATTEMPTS=3
RETENTION_DAYS=365
# No staff password is stored here; create it interactively after migration.
