# Use HTTPS and your reachable hostname for customer deployment.
# Start-Shop.cmd and Start-Work1.cmd deliberately do not load this file.
# For the Docker HTTPS overlay, use deploy/production.env.example instead.
BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
NODE_ENV=development
# Optional only if using an explicitly audited locally installed browser.
# CHROMIUM_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Docker uses Playwright's version-matched downloaded Chromium.
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=50000000
# Refuse new uploads before the storage reserve is exhausted.
MIN_FREE_STORAGE_MB=10
REQUIRE_BUNDLED_FONTS=1
JOB_TIMEOUT_MS=900000
JOB_MAX_ATTEMPTS=3
# Offline retention is dry-run unless scripts/retention.js receives --apply.
RETENTION_DAYS=365
